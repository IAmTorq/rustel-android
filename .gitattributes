# The corpus suite reads its scores and goldens back byte for byte, and hashes
# what they produce. A checkout that rewrote their line endings would change
# what is measured, so they are LF wherever they land.
crates/runtime/tests/e2e/** text eol=lf

# Some imported scores intentionally retain upstream trailing whitespace.
crates/runtime/tests/e2e/scores/** whitespace=-trailing-space,-blank-at-eof

# The built-in theme document is data, so its line endings are LF wherever
# it lands. The ASCII art it once sat beside moved to rustel-studio-themes,
# whose own attributes keep those files byte-exact.
crates/studio/src/themes/** text eol=lf
# The vendored logo renderer indexes its ASCII rows by byte offset.
android-native/vendor/rustel-studio-themes/themes/rustel-logo.txt text eol=lf

# The studio e2e suite compares its goldens as text; the comparison also
# normalises CRLF itself, so a checkout with eol rewriting stays correct.
crates/studio-e2e/goldens/** text eol=lf

# check-engine.sh compares the base engine profile's dependency snapshot with
# cargo's output line for line, so the snapshot is LF wherever it lands.
.github/scripts/engine-base-dependencies.txt text eol=lf

# Release scripts execute in Bash and deployed installers must match byte for byte.
.github/scripts/**/*.sh text eol=lf
.github/scripts/*.sh text eol=lf
rustelup/install text eol=lf
rustelup/install.ps1 text eol=lf
rustelup/rustelup text eol=lf
rustelup/rustelup.ps1 text eol=lf

# Preserve vendored source and compiled assets byte-for-byte. Their upstream
# whitespace is not authored port code; local patches have separate provenance.
android-native/vendor/mp3lame-sys/lame-3.100/** -whitespace
android/app/assets/xterm.js -text -whitespace
android/app/assets/addon-webgl.js -text -whitespace
android/app/assets/addon-fit.js -text -whitespace

# New port source uses LF on all development hosts.
android/**/*.py text eol=lf
android/**/*.ps1 text eol=lf
android/**/*.java text eol=lf
android/**/*.cjs text eol=lf
android/**/*.json text eol=lf
android/**/*.md text eol=lf
android/**/*.xml text eol=lf
android-native/src/*.rs text eol=lf
.githooks/* text eol=lf

# The unmodified LAME HACKING heading uses seven equals signs as an underline.
android-native/vendor/mp3lame-sys/lame-3.100/HACKING conflict-marker-size=32
